# ==========================================
# ShopEase - Environment Variables Example
# ==========================================
# Copy this file to server/.env and fill in your actual values.
# NEVER commit .env to version control.

# ── Server ──────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────
# Get your URI from https://cloud.mongodb.com
MONGODB_URI=MONGODB_URI=mongodb+srv://Shopeaseadmin:Navv234@cluster0.oakfroh.mongodb.net/shopease?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── Cloudinary ──────────────────────────
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay ────────────────────────────
# Get credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Email (Nodemailer) ───────────────────
# For development you can use Mailtrap: https://mailtrap.io
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_password
EMAIL_FROM=noreply@shopease.com

# ── Client URL (for CORS) ────────────────
CLIENT_URL=http://localhost:3000
